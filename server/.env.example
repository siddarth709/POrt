# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT secret - any long random string
JWT_SECRET=replace_this_with_a_long_random_string

# Single admin login credentials (used by seed script to create the one owner account)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Cloudinary (free tier) - for image uploads from the dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: email notification when someone messages you via the Contact section
# Use a Gmail "App Password" (not your real password) - free
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_EMAIL=you@example.com

# Frontend URL (for CORS) - your Render static site URL once deployed
CLIENT_URL=http://localhost:5173

PORT=5000
